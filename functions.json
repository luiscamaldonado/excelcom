      "parameters": [
        {
          "name": "NOVO_COSTO",
          "description": "Costo del producto (numerico).",
          "type": "number",
          "dimensionality": "scalar"
        },
        {
          "name": "NOVO_MARGEN",
          "description": "Margen de ganancia (porcentaje).",
          "type": "number",
          "dimensionality": "scalar"
        }
      ],
      "result": {
        "type": "number",
        "dimensionality": "scalar"
      },
      "options": {
        "sync": true
      }
    }
  ]
